<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="#000000" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp">
        <ImageView android:id="@+id/logo" android:layout_width="150dp" android:layout_height="56dp" android:src="@drawable/mehedi_iptv_logo" android:scaleType="centerInside" android:contentDescription="Mehedi IPTV"/>
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end|center_vertical" android:text="Updating channels..." android:textColor="#A8A8A8" android:textSize="13sp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="10dp" android:clipToPadding="false" android:background="#050505"/>
    <FrameLayout android:id="@+id/tickerContainer" android:layout_width="match_parent" android:layout_height="38dp" android:background="#160000" android:clipChildren="true" android:clipToPadding="true">
        <TextView android:id="@+id/ticker" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:singleLine="true" android:text="মেহেদী ইন্টারনেট সংযোগ নেওয়ার জন্য যোগাযোগ করুন ০১৬২৬৮৮৬০৭০" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:paddingStart="8dp" android:paddingEnd="8dp"/>
    </FrameLayout>
</LinearLayout>
