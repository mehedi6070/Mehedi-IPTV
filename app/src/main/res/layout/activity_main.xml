<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:orientation="vertical"
    android:background="#050505"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="185dp"
            android:layout_height="64dp"
            android:src="@drawable/mehedi_iptv_logo"
            android:scaleType="centerInside"
            android:contentDescription="Mehedi IPTV"/>
        <FrameLayout
            android:id="@+id/tickerBox"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="18dp"
            android:background="@drawable/bg_ticker"
            android:clipChildren="true">
            <TextView
                android:id="@+id/ticker"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="📢 মেহেদী ইন্টারনেট সংযোগ নেওয়ার জন্য যোগাযোগ করুন → ০১৬২৬৮৮৬০৭০"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </FrameLayout>
        <TextView
            android:id="@+id/status"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:gravity="center"
            android:text="Updating..."
            android:textColor="#A8A8A8"
            android:textSize="14sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#E50914"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categories"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:clipToPadding="false"
        android:background="#090909"
        android:nextFocusDown="@id/channels"
        android:focusable="true"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/channels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="18dp"
        android:clipToPadding="false"
        android:background="#050505"
        android:nextFocusUp="@id/categories"
        android:focusable="true"/>
</LinearLayout>
