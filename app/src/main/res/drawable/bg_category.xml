<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#E50914"/><stroke android:width="3dp" android:color="#FF4A4A"/><corners android:radius="14dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#B00000"/><corners android:radius="14dp"/></shape></item>
    <item><shape><solid android:color="#151515"/><stroke android:width="1dp" android:color="#333333"/><corners android:radius="14dp"/></shape></item>
</selector>
