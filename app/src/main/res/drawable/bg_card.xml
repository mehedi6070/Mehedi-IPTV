<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#191919"/><stroke android:width="3dp" android:color="#E50914"/><corners android:radius="12dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#202020"/><stroke android:width="2dp" android:color="#E50914"/><corners android:radius="12dp"/></shape></item>
    <item><shape><solid android:color="#101010"/><stroke android:width="1dp" android:color="#262626"/><corners android:radius="12dp"/></shape></item>
</selector>
